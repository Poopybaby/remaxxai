# Copy to .env.local for local development, and add the same keys in Vercel → Project → Settings →
# Environment Variables. Never commit real values. Anything starting with NEXT_PUBLIC_ is visible
# in the browser; everything else stays on the server.

# ── App URLs ───────────────────────────────────────────────────────────────────
# Where the app runs. Production: https://remaxx.ai
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Separate domain that serves untrusted previews. Must NOT be a subdomain of the app domain.
# Production: https://remaxxusercontent.com (or whichever preview domain you register).
# Local dev: 127.0.0.1 is a different site from localhost, so it works as a stand-in.
NEXT_PUBLIC_PREVIEW_ORIGIN=http://127.0.0.1:3000

# ── Supabase (Phase 1) ─────────────────────────────────────────────────────────
# Supabase dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
# The "publishable" key (sb_publishable_...). Older projects call it the "anon" key; either works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The "secret" key (sb_secret_...). Older projects call it "service_role". SERVER ONLY.
SUPABASE_SECRET_KEY=
# Supabase dashboard → Connect → ORMs / connection string.
# Use the transaction pooler (port 6543) for the app on Vercel. For `pnpm db:migrate`, the direct or
# session connection (port 5432) is safer; you can override DATABASE_URL just for that command.
DATABASE_URL=

# ── Rate limiting (optional now, required before public launch) ────────────────
# Upstash console → Redis → REST API. Without these, limits are per-server-instance only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Coming in later phases (leave blank for now) ───────────────────────────────
# Phase 3: OPENAI_API_KEY (embeddings + moderation)
# Phase 4: ANTHROPIC_API_KEY, GOOGLE_GENERATIVE_AI_API_KEY, DEEPSEEK_API_KEY
# Phase 5: STRIPE_SECRET_KEY, NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY, STRIPE_WEBHOOK_SECRET
# Phase 6: SENTRY_DSN, NEXT_PUBLIC_POSTHOG_KEY
